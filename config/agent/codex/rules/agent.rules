prefix_rule(
    pattern = ["jj", ["diff", "help", "log", "show", "st", "status"]],
    decision = "allow",
    justification = "Common local jj inspection commands are read-only.",
    match = [
        "jj diff",
        "jj diff --stat",
        "jj help split",
        "jj log -r trunk()..@",
        "jj show @-",
        "jj st",
        "jj status",
    ],
)

prefix_rule(
    pattern = ["jj", "file", ["annotate", "list", "search", "show"]],
    decision = "allow",
    justification = "These jj file commands inspect tracked content without changing it.",
    match = [
        "jj file annotate config.toml",
        "jj file list",
        "jj file search approval",
        "jj file show config.toml",
    ],
    not_match = [
        "jj file chmod +x script",
        "jj file track generated.txt",
    ],
)

prefix_rule(
    pattern = ["jj", "workspace", ["list", "root"]],
    decision = "allow",
    justification = "Listing jj workspaces and resolving the current root are read-only.",
    match = [
        "jj workspace list",
        "jj workspace root",
    ],
)

prefix_rule(
    pattern = ["jj", ["absorb", "commit", "describe", "edit", "new", "rebase", "split", "squash"]],
    decision = "allow",
    justification = "These common local jj operations are recoverable through the operation log; the jj guard still blocks immutability bypasses.",
    match = [
        "jj absorb",
        "jj commit -m 'agent: title'",
        "jj describe -m 'agent: title'",
        "jj edit @-",
        "jj new trunk()",
        "jj rebase -r @ -d trunk()",
        "jj split config/agent/global.md -m 'agent: title'",
        "jj squash -u",
    ],
    not_match = [
        "jj abandon @",
        "jj restore config.toml",
        "jj undo",
    ],
)

prefix_rule(
    pattern = ["jj", ["abandon", "restore", "undo"]],
    decision = "prompt",
    justification = "Discarding changes or reversing an operation requires explicit review.",
    match = [
        "jj abandon @",
        "jj restore config.toml",
        "jj undo",
    ],
)

prefix_rule(
    pattern = ["jj", "workspace", ["add", "forget", "rename", "update-stale"]],
    decision = "prompt",
    justification = "Workspace mutations can write outside the current root or detach working-copy state.",
    match = [
        "jj workspace add ../other-copy",
        "jj workspace forget old-copy",
        "jj workspace rename primary",
        "jj workspace update-stale",
    ],
)

prefix_rule(
    pattern = ["jj", "bookmark", ["delete", "forget"]],
    decision = "prompt",
    justification = "Bookmark removal can alter what a later sync publishes or retains.",
    match = [
        "jj bookmark delete topic",
        "jj bookmark forget topic@origin",
    ],
)

prefix_rule(
    pattern = ["jj", "git"],
    decision = "forbidden",
    justification = "Use jj sync yourself; agents must not run jj git commands in colocated repos.",
    match = [
        "jj git fetch",
        "jj git push",
    ],
)

prefix_rule(
    pattern = ["jj", "op", "log"],
    decision = "allow",
    justification = "Inspecting the jj operation log is read-only and useful before recovery.",
    match = [
        "jj op log",
        "jj op log -n 5",
    ],
)

prefix_rule(
    pattern = ["jj", "op", ["abandon", "integrate", "restore", "revert"]],
    decision = "forbidden",
    justification = "Operation-log mutation and recovery commands are destructive enough to require explicit user instruction.",
    match = [
        "jj op abandon old-op",
        "jj op integrate old-op",
        "jj op restore abc123",
        "jj op revert abc123",
    ],
)

prefix_rule(
    pattern = ["make", ["build", "check", "ci", "full-verify", "lint", "test"]],
    decision = "allow",
    justification = "Run selected routine make verification prefixes from a trusted repository without repeated approval review.",
    match = [
        "make build",
        "make build area=ios",
        "make check",
        "make ci",
        "make full-verify",
        "make lint area=server",
        "make test area=ios",
    ],
    not_match = [
        "make clean",
        "make deploy",
        "make install",
    ],
)

prefix_rule(
    pattern = ["mise", "run", ["build", "check", "ci", "full-verify", "lint", "test", "typecheck"]],
    decision = "allow",
    justification = "Run selected routine mise verification prefixes from a trusted repository without repeated approval review.",
    match = [
        "mise run build",
        "mise run check",
        "mise run lint",
        "mise run test -- --filter unit",
        "mise run typecheck",
    ],
    not_match = [
        "mise exec -- python script.py",
        "mise install",
        "mise run deploy",
    ],
)

prefix_rule(
    pattern = ["bun", "test"],
    decision = "allow",
    justification = "Run a trusted repository's Bun test suite without repeated approval review.",
    match = [
        "bun test",
        "bun test tests/unit",
    ],
)

prefix_rule(
    pattern = ["bun", "run", ["build", "check", "ci", "lint", "test", "typecheck"]],
    decision = "allow",
    justification = "Run selected routine Bun verification prefixes from a trusted repository without repeated approval review.",
    match = [
        "bun run build",
        "bun run check",
        "bun run lint",
        "bun run test --watch=false",
        "bun run typecheck",
    ],
    not_match = [
        "bun run deploy",
        "bun run publish",
        "bun x eslint .",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest"],
    decision = "allow",
    justification = "Run focused pytest checks from a trusted repository when its canonical task runner has no narrower target.",
    match = [
        "uv run pytest",
        "uv run pytest tests/test_api.py -q",
    ],
    not_match = [
        "uv run python script.py",
        "uv sync",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "--group", "dev", "pytest"],
    decision = "allow",
    justification = "Run the documented focused pytest form with development dependencies.",
    match = [
        "uv run --group dev pytest tests/test_api.py -q",
    ],
)

prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow",
    justification = "Allow read-only GitHub CLI authentication checks outside the sandbox.",
    match = [
        "gh auth status",
    ],
)


prefix_rule(
    pattern = ["/bin/zsh", "-lc", "AGENT_HOOK_FORMAT=codex config/agent/hooks/commit-nudge.sh"],
    decision = "allow",
    justification = "Run the shared Codex commit-nudge hook check.",
)

prefix_rule(
    pattern = ["gh", "issue", ["list", "status", "view"]],
    decision = "allow",
    justification = "Allow read-only GitHub issue inspection outside the sandbox.",
    match = [
        "gh issue list --repo cebrusfs/Aureus --json number,title,state",
        "gh issue status --repo cebrusfs/Aureus",
        "gh issue view 77 --repo cebrusfs/Aureus --json number,title,body,state,labels,assignees,comments",
    ],
    not_match = [
        "gh issue edit 77 --repo cebrusfs/Aureus",
        "gh issue comment 77 --repo cebrusfs/Aureus --body ok",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["checks", "diff", "list", "status", "view"]],
    decision = "allow",
    justification = "Allow read-only GitHub PR inspection outside the sandbox.",
    match = [
        "gh pr view 12 --repo cebrusfs/Aureus --json number,title,state",
        "gh pr list --repo cebrusfs/Aureus --json number,title,state",
        "gh pr checks 12 --repo cebrusfs/Aureus",
        "gh pr diff 12 --repo cebrusfs/Aureus",
        "gh pr status --repo cebrusfs/Aureus",
    ],
    not_match = [
        "gh pr merge 12 --repo cebrusfs/Aureus",
        "gh pr review 12 --repo cebrusfs/Aureus --approve",
    ],
)

prefix_rule(
    pattern = ["gh", "repo", ["list", "view"]],
    decision = "allow",
    justification = "Allow read-only GitHub repository inspection outside the sandbox.",
    match = [
        "gh repo view cebrusfs/Aureus --json name,owner,description",
        "gh repo list cebrusfs --limit 10",
    ],
)

prefix_rule(
    pattern = ["gh", "run", ["list", "view"]],
    decision = "allow",
    justification = "Allow read-only GitHub Actions run inspection outside the sandbox.",
    match = [
        "gh run list --repo cebrusfs/Aureus --limit 10",
        "gh run view 123 --repo cebrusfs/Aureus --json status,conclusion",
    ],
    not_match = [
        "gh run rerun 123 --repo cebrusfs/Aureus",
        "gh run cancel 123 --repo cebrusfs/Aureus",
    ],
)

prefix_rule(
    pattern = ["gh", "workflow", ["list", "view"]],
    decision = "allow",
    justification = "Allow read-only GitHub Actions workflow inspection outside the sandbox.",
    match = [
        "gh workflow list --repo cebrusfs/Aureus",
        "gh workflow view test.yml --repo cebrusfs/Aureus",
    ],
)

prefix_rule(
    pattern = ["gh", "release", ["list", "view"]],
    decision = "allow",
    justification = "Allow read-only GitHub release inspection outside the sandbox.",
    match = [
        "gh release list --repo cebrusfs/Aureus",
        "gh release view v1.0.0 --repo cebrusfs/Aureus",
    ],
)

prefix_rule(
    pattern = ["gh", "search", ["issues", "prs", "repos"]],
    decision = "allow",
    justification = "Allow read-only GitHub search outside the sandbox.",
    match = [
        "gh search issues sandbox --owner cebrusfs --json number,title,repository",
        "gh search prs sandbox --owner cebrusfs --json number,title,repository",
        "gh search repos dotfiles --owner cebrusfs --json name,owner",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", ["close", "comment", "create", "delete", "develop", "edit", "lock", "pin", "reopen", "transfer", "unlock", "unpin"]],
    decision = "prompt",
    justification = "GitHub issue mutations need explicit review before running outside the sandbox.",
)

prefix_rule(
    pattern = ["gh", "pr", ["checkout", "close", "comment", "create", "edit", "lock", "merge", "ready", "reopen", "review", "unlock"]],
    decision = "prompt",
    justification = "GitHub PR mutations or checkout side effects need explicit review before running outside the sandbox.",
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "GitHub API calls can read or mutate arbitrary resources; review each invocation.",
)

prefix_rule(
    pattern = ["gh", "repo", ["archive", "create", "delete", "deploy-key", "edit", "fork", "rename", "set-default", "sync", "unarchive"]],
    decision = "prompt",
    justification = "GitHub repository mutations need explicit review before running outside the sandbox.",
)

prefix_rule(
    pattern = ["gh", "run", ["cancel", "delete", "download", "rerun", "watch"]],
    decision = "prompt",
    justification = "GitHub Actions run side effects or local writes need explicit review before running outside the sandbox.",
)

prefix_rule(
    pattern = ["gh", "workflow", ["disable", "enable", "run"]],
    decision = "prompt",
    justification = "GitHub Actions workflow mutations need explicit review before running outside the sandbox.",
)

prefix_rule(
    pattern = ["gh", "release", ["create", "delete", "delete-asset", "edit", "upload"]],
    decision = "prompt",
    justification = "GitHub release mutations need explicit review before running outside the sandbox.",
)
